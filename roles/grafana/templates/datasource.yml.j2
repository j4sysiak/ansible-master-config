apiVersion: 1

datasources:
  - name: InfluxDB_Ansible
    type: influxdb
    access: proxy
    url: http://localhost:8086
    jsonData:
      version: Flux
      organization: {{ influxdb_org }}      # <-- BEZ CUDZYSŁOWÓW
      defaultBucket: {{ influxdb_bucket }}   # <-- BEZ CUDZYSŁOWÓW
      tlsSkipVerify: "true" # <-- Zmienione na string
    secureJsonData:
      token: "{{ influxdb_admin_token }}" # <-- TUTAJ CUDZYSŁÓW JEST DOBRY!